  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-17823",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "effect": "4.0.0-rc.112",
    "opencode-drive": "2.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
