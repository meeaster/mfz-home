{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mindframe-z-work-ledger",
  "private": true,
  "description": "Session-to-ledger bindings for the OpenCode V2 server and TUI",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./src/tui.ts"
  },
  "scripts": {
