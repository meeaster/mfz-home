{
  "name": "@mfz/cairn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "cairn": "./dist/cli.js",
    "cairn-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --watch",
    "dev:ui": "vite",
    "prepack": "node build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
