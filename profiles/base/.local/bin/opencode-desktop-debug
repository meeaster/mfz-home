#!/usr/bin/env node
// Exposes OpenCode Desktop's Chrome DevTools Protocol port to WSL so agent-browser can
// drive and record the Windows app. The relay itself lives in windows-cdp-debug.mjs.
import { fileURLToPath } from "node:url";
import { powershell, runCli } from "./windows-cdp-debug.mjs";

runCli(
  {
    name: "opencode-desktop-debug",
    label: "OpenCode Desktop",
    envPrefix: "OPENCODE_DESKTOP",
    envHelp: "  OPENCODE_DESKTOP_EXE         Windows path to OpenCode.exe",
    defaultPort: 9222,
    processName: "opencode",
    running: () => powershell("@(Get-Process -Name OpenCode -ErrorAction SilentlyContinue).Count") !== "0",
    launch(port) {
      const exe = process.env.OPENCODE_DESKTOP_EXE ?? "$env:LOCALAPPDATA\\Programs\\@opencode-aidesktop\\OpenCode.exe";

      powershell(`Start-Process -FilePath "${exe}" -ArgumentList '--remote-debugging-port=${port}'`);
    },
  },
  fileURLToPath(import.meta.url),
);
