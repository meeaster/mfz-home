[Unit]
Description=OpenCode V2 service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mark/workspace
Environment=HOME=/home/mark
Environment=PATH=/home/mark/.local/bin:/home/mark/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/mark/.local/bin/opencode2 serve --service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
