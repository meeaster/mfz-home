#!/bin/sh

root="$HOME/.local/share/opencode-v2"

export OPENCODE_CONFIG_DIR="$HOME/.config/opencode-v2"
export OPENCODE_DB="$root/data/opencode-v2.db"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_STATE_HOME="$root/state"
export XDG_CACHE_HOME="$root/cache"

real="${MFZ_OPENCODE2_REAL:-$HOME/.local/share/mise/installs/node/26/bin/opencode2}"
exec "$real" "$@"
